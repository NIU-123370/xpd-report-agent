# Local-only Hermes gateway configuration.
HERMES_GATEWAY_HOST=127.0.0.1
HERMES_GATEWAY_PORT=8642
HERMES_GATEWAY_API_KEY=dev-secret
HERMES_GATEWAY_MODEL=hermes-agent
HERMES_GATEWAY_ALLOW_ALL_USERS=true
HERMES_TIMEZONE=Asia/Shanghai

# Model provider configuration used by Hermes.
HERMES_LLM_PROVIDER=custom
HERMES_LLM_MODEL=qwen3.7-max
HERMES_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HERMES_LLM_API_MODE=chat_completions
HERMES_LLM_API_KEY=

HERMES_BOOTSTRAP_ON_START=false
XPD_HERMES_REASONING_STREAM_PATCH=true
XPD_HERMES_CLARIFY_PATCH=true
XPD_CLARIFY_TIMEOUT_SECONDS=300
XPD_HERMES_REPORT_FILE_PATCH=true
XPD_HERMES_CRON_PATCH=false
# Generated CSV/XLSX/Markdown/PDF/JSON reports. Use a persistent volume in production.
# XPD_FILE_STORAGE_PATH=/persistent/xpd-report-agent/report-files
# Optional on macOS. Linux production should point this at an installed embeddable
# TrueType Chinese font, for example WenQuanYi Zen Hei.
# XPD_PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
XPD_FILE_MAX_ARTIFACTS_PER_SESSION=50
XPD_FILE_MAX_BYTES_PER_ARTIFACT=10485760
XPD_FILE_MAX_TOTAL_BYTES_PER_SESSION=104857600
XPD_FILE_MAX_TOTAL_BYTES_PER_OWNER=524288000
XPD_FILE_MAX_TOTAL_BYTES=5368709120
XPD_FILE_MIN_FREE_BYTES=268435456
XPD_FILE_RETENTION_DAYS=30
# Local development defaults to local-only files. To exercise OSS, set true and
# fill the endpoint, region and dedicated report credentials below.
XPD_REPORT_OSS_ENABLED=false
XPD_REPORT_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
XPD_REPORT_OSS_REGION=cn-beijing
XPD_REPORT_OSS_BUCKET=starpartner-biz
XPD_REPORT_OSS_PREFIX=public/dev/agent-report-files/
XPD_REPORT_OSS_ACCESS_KEY_ID=
XPD_REPORT_OSS_ACCESS_KEY_SECRET=
XPD_REPORT_OSS_DOWNLOAD_EXPIRES_SECONDS=3600
# Successful db_execute_sql results are held briefly so exports use exact queried rows.
XPD_QUERY_RESULT_TTL_SECONDS=3600
XPD_QUERY_RESULT_MAX_ENTRIES=500
XPD_QUERY_RESULT_MAX_PER_SESSION=20
XPD_QUERY_RESULT_MAX_BYTES_PER_RESULT=5242880
XPD_QUERY_RESULT_MAX_TOTAL_BYTES=52428800
HERMES_REQUIRE_LLM_API_KEY=true

# Hermes-native Cron triggers owner-scoped xpd report sessions.
XPD_SCHEDULES_ENABLED=false
# Persist this file together with Hermes Home in production.
# XPD_SCHEDULE_STATE_PATH=/persistent/hermes/xpd-report-agent/schedules.json
# Defaults to <HERMES_HOME>/scripts and must be shared with the Hermes process.
# XPD_CRON_SCRIPT_DIR=/persistent/hermes/scripts
# Use an internal FastAPI origin when Hermes and FastAPI run in separate containers.
# XPD_CRON_CALLBACK_ORIGIN=http://xpd-fastapi:8000
XPD_SCHEDULE_RUN_MAX_ATTEMPTS=2
XPD_CRON_MAX_PARALLEL_JOBS=1

# Session history and Hermes-native long-term memory.
# Use a separate high-entropy secret in production. When empty, the wrapper
# falls back to HERMES_GATEWAY_API_KEY for local development only.
XPD_SESSION_SIGNING_SECRET=
# Keep session_key for the current local browser. When integrating with the
# live-commerce middle platform, switch to user_id and have its authenticated
# backend send the stable user ID in the X-User-Id request header.
XPD_IDENTITY_MODE=session_key
# Local browser debugging stays unauthenticated. Set true when testing the
# middle-platform Bearer contract and provide a separate high-entropy key.
XPD_SERVICE_AUTH_ENABLED=false
XPD_SERVICE_API_KEY=
# Hermes native session_search is not owner-scoped. It remains available in
# local session_key mode and is disabled by default in user_id mode. Do not
# enable this compatibility switch for a multi-user deployment.
XPD_UNSAFE_USER_SESSION_SEARCH_ENABLED=false
# Installed in Hermes now, but only becomes active when XPD_IDENTITY_MODE=user_id.
XPD_HERMES_USER_MEMORY_PATCH=true
# In user_id mode this read-only file is injected for every employee:
# <HERMES_HOME>/memories/merchant/MEMORY.md
XPD_MERCHANT_MEMORY_ENABLED=true
XPD_MERCHANT_MEMORY_CHAR_LIMIT=2200
# Retrieve only the closest 1-3 versioned merchant-question examples per turn.
XPD_MERCHANT_QUESTION_LIBRARY_ENABLED=true
XPD_MERCHANT_QUESTION_TOP_K=3
# XPD_MERCHANT_QUESTION_LIBRARY_PATH=/app/knowledge/merchant_questions.yaml
XPD_METRIC_DEFINITION_LIBRARY_ENABLED=true
XPD_METRIC_DEFINITION_TOP_K=6
# XPD_METRIC_DEFINITION_LIBRARY_PATH=/app/knowledge/metric_definitions.yaml
XPD_SESSION_ENABLED=true
# Durable idempotent runs used by the middle-platform API.
# XPD_AGENT_RUN_STATE_PATH=/persistent/hermes/xpd-report-agent/agent-runs.json
XPD_AGENT_MAX_CONCURRENCY=3
XPD_AGENT_RUN_MAX_ATTEMPTS=2
XPD_AGENT_CHAT_TIMEOUT_SECONDS=600
XPD_AGENT_RECONCILE_SECONDS=10
XPD_AGENT_OUTCOME_RECONCILE_SECONDS=600
XPD_AGENT_RUN_SHUTDOWN_GRACE_SECONDS=30
XPD_HERMES_CONNECT_MAX_ATTEMPTS=3
XPD_HERMES_RETRY_BASE_SECONDS=0.2
XPD_MEMORY_ENABLED=true
XPD_PERIODIC_REFLECTION_ENABLED=true
XPD_FINAL_REFLECTION_ENABLED=true
XPD_FINAL_REFLECTION_TIMEOUT_SECONDS=180
XPD_REFLECTION_INTERVAL=3
XPD_SESSION_IDLE_MINUTES=30
XPD_MEMORY_CHAR_LIMIT=2200
XPD_USER_CHAR_LIMIT=1375
XPD_MEMORY_CONSOLIDATION_RATIO=0.8
XPD_MEMORY_CRITICAL_RATIO=0.95
XPD_MEMORY_CONSOLIDATION_TARGET_RATIO=0.6
XPD_MEMORY_AUTO_CONSOLIDATION_ENABLED=true
XPD_MEMORY_CONSOLIDATION_SCAN_SECONDS=30
XPD_MEMORY_CONSOLIDATION_MAX_ATTEMPTS=3
XPD_MEMORY_CONSOLIDATION_RETRY_COOLDOWN_SECONDS=600
# XPD_REFLECTION_STATE_PATH=/persistent/hermes/xpd-report-agent/reflections.json

# MySQL report database queried by the db-query plugin.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Configure the DMS/RDS endpoint and account here. Grant production permissions
# in DMS; the application does not create or modify cloud database accounts.
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=taobao_reports_test
XPD_MYSQL_READ_MAX_ATTEMPTS=2
XPD_MYSQL_READ_RETRY_BACKOFF_MS=100
# Agent 查询的 MySQL 服务端执行上限，允许范围 1000～29000 毫秒。
XPD_MYSQL_QUERY_TIMEOUT_MS=25000

FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=false
