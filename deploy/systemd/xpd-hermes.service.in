[Unit]
Description=XPD Report Agent - Hermes gateway
Documentation=file://@PROJECT_ROOT@/deploy/systemd/README.md
Wants=network-online.target
After=network-online.target
PartOf=xpd-report-agent.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=HOME=@SERVICE_HOME@
Environment=LAUNCH_MANAGED=true
EnvironmentFile=@ENV_FILE@
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/scripts/services/hermes.sh run
ExecStartPost=@PROJECT_ROOT@/.venv/bin/python -S @PROJECT_ROOT@/deploy/systemd/healthcheck.py hermes --timeout-seconds 90
TimeoutStartSec=120s
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45s
SendSIGKILL=yes
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xpd-hermes

[Install]
WantedBy=xpd-report-agent.target
