# Copy to a root-owned file such as /etc/xpd-report-agent/xpd-report-agent.env.
# Keep permissions at 0640 or stricter. Do not commit the populated file.

HERMES_GATEWAY_HOST=127.0.0.1
HERMES_GATEWAY_PORT=8642
HERMES_GATEWAY_API_KEY=REPLACE_WITH_A_HIGH_ENTROPY_SECRET
HERMES_GATEWAY_MODEL=hermes-agent
HERMES_GATEWAY_ALLOW_ALL_USERS=false
HERMES_TIMEZONE=Asia/Shanghai

HERMES_LLM_PROVIDER=custom
HERMES_LLM_MODEL=REPLACE_WITH_MODEL_NAME
HERMES_LLM_BASE_URL=REPLACE_WITH_PROVIDER_BASE_URL
HERMES_LLM_API_MODE=chat_completions
HERMES_LLM_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
HERMES_BOOTSTRAP_ON_START=false
HERMES_REQUIRE_LLM_API_KEY=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Provision this non-root, SELECT-only account in DMS/RDS before deployment.
MYSQL_USER=REPLACE_WITH_SELECT_ONLY_DATABASE_USER
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
MYSQL_DATABASE=taobao_reports_test

FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=false

XPD_IDENTITY_MODE=user_id
XPD_SERVICE_AUTH_ENABLED=true
XPD_SERVICE_API_KEY=REPLACE_WITH_A_SEPARATE_HIGH_ENTROPY_SERVICE_KEY
# Unsafe compatibility only: Hermes native session_search is process-global
# and is therefore disabled in user_id mode unless this is explicitly true.
XPD_UNSAFE_USER_SESSION_SEARCH_ENABLED=false
XPD_SESSION_SIGNING_SECRET=REPLACE_WITH_A_DIFFERENT_HIGH_ENTROPY_SECRET
XPD_HERMES_USER_MEMORY_PATCH=true
XPD_MERCHANT_MEMORY_ENABLED=true
XPD_MERCHANT_QUESTION_LIBRARY_ENABLED=true
XPD_MERCHANT_QUESTION_TOP_K=3
# XPD_MERCHANT_QUESTION_LIBRARY_PATH=/opt/xpd-report-agent/knowledge/merchant_questions.yaml
XPD_METRIC_DEFINITION_LIBRARY_ENABLED=true
XPD_METRIC_DEFINITION_TOP_K=6
# XPD_METRIC_DEFINITION_LIBRARY_PATH=/opt/xpd-report-agent/knowledge/metric_definitions.yaml
XPD_MEMORY_ENABLED=true
XPD_PERIODIC_REFLECTION_ENABLED=true
XPD_FINAL_REFLECTION_ENABLED=true
XPD_FINAL_REFLECTION_TIMEOUT_SECONDS=180
XPD_MEMORY_CONSOLIDATION_RATIO=0.8
XPD_MEMORY_CRITICAL_RATIO=0.95
XPD_MEMORY_CONSOLIDATION_TARGET_RATIO=0.6
XPD_MEMORY_AUTO_CONSOLIDATION_ENABLED=true
XPD_MEMORY_CONSOLIDATION_SCAN_SECONDS=30
XPD_MEMORY_CONSOLIDATION_MAX_ATTEMPTS=3
XPD_MEMORY_CONSOLIDATION_RETRY_COOLDOWN_SECONDS=600
XPD_HERMES_REASONING_STREAM_PATCH=true
XPD_HERMES_CLARIFY_PATCH=true
XPD_HERMES_REPORT_FILE_PATCH=true
XPD_HERMES_CRON_PATCH=false
XPD_SCHEDULES_ENABLED=false

# All stateful paths must live on persistent storage and be writable by the
# service user. Replace these examples with paths for the target server.
XPD_FILE_STORAGE_PATH=/var/lib/xpd-report-agent/report-files
XPD_REPORT_OSS_ENABLED=true
XPD_REPORT_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
XPD_REPORT_OSS_REGION=cn-beijing
XPD_REPORT_OSS_BUCKET=starpartner-biz
XPD_REPORT_OSS_PREFIX=public/dev/agent-report-files/
XPD_REPORT_OSS_ACCESS_KEY_ID=REPLACE_WITH_REPORT_OSS_ACCESS_KEY_ID
XPD_REPORT_OSS_ACCESS_KEY_SECRET=REPLACE_WITH_REPORT_OSS_ACCESS_KEY_SECRET
XPD_REPORT_OSS_DOWNLOAD_EXPIRES_SECONDS=3600
# Install an embeddable Chinese TrueType font and configure its absolute path.
XPD_PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
XPD_SCHEDULE_STATE_PATH=/var/lib/xpd-report-agent/state/schedules.json
XPD_REFLECTION_STATE_PATH=/var/lib/xpd-report-agent/state/reflections.json
XPD_AGENT_RUN_STATE_PATH=/var/lib/xpd-report-agent/state/agent-runs.json
XPD_CRON_SCRIPT_DIR=/var/lib/xpd-report-agent/hermes/scripts

# Bounded recovery. Hermes already retries model-provider failures internally;
# these settings cover the wrapper connection and read-only MySQL tool layer.
XPD_AGENT_MAX_CONCURRENCY=3
XPD_AGENT_RUN_MAX_ATTEMPTS=2
XPD_AGENT_CHAT_TIMEOUT_SECONDS=600
XPD_AGENT_RECONCILE_SECONDS=10
XPD_AGENT_OUTCOME_RECONCILE_SECONDS=600
XPD_AGENT_RUN_SHUTDOWN_GRACE_SECONDS=30
XPD_HERMES_CONNECT_MAX_ATTEMPTS=3
XPD_HERMES_RETRY_BASE_SECONDS=0.2
XPD_MYSQL_READ_MAX_ATTEMPTS=2
XPD_MYSQL_READ_RETRY_BACKOFF_MS=100
