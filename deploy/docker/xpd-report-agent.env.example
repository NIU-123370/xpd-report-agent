# 复制为 xpd-report-agent.env 后填写真实值。该文件已被 Git 忽略。
HERMES_LLM_PROVIDER=custom
HERMES_LLM_MODEL=qwen3.7-max
HERMES_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HERMES_LLM_API_MODE=chat_completions
HERMES_LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
HERMES_REQUIRE_LLM_API_KEY=true
HERMES_GATEWAY_API_KEY=REPLACE_WITH_INTERNAL_GATEWAY_KEY

# DMS/RDS 环境；应用也兼容标准 MYSQL_* 变量。以下值必须替换为目标环境配置。
XPD_DB_HOST=REPLACE_WITH_RDS_HOST
XPD_DB_PORT=3306
XPD_DB_NAME=REPLACE_WITH_DATABASE_NAME
XPD_DB_USERNAME=REPLACE_WITH_DATABASE_USERNAME
XPD_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Agent 查询的 MySQL 服务端执行上限，允许范围 1000～29000 毫秒。
XPD_MYSQL_QUERY_TIMEOUT_MS=25000

# 中台接入配置。
XPD_IDENTITY_MODE=user_id
XPD_SERVICE_AUTH_ENABLED=true
XPD_SERVICE_API_KEY=REPLACE_WITH_MIDDLE_PLATFORM_API_KEY
XPD_SESSION_SIGNING_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
XPD_UNSAFE_USER_SESSION_SEARCH_ENABLED=false
# FastAPI 节点池全局并发上限；20 是初始值，应根据模型限流、RDS 连接数和压测结果下调。
XPD_AGENT_MAX_CONCURRENCY=20

# FastAPI/Hermes 的节点池、主机名、内部端口和定时回调地址由
# compose.yaml 按容器角色固定配置，不要在这个共享环境文件中覆盖。
FASTAPI_RELOAD=false
HERMES_BOOTSTRAP_ON_START=false
# 定时报告默认关闭。若要开启，这两项需要同时设为 true；Compose 仅允许
# hermes-1 作为 Cron leader，hermes-2 和 hermes-3 会强制覆盖为 false。
XPD_SCHEDULES_ENABLED=false
XPD_HERMES_CRON_PATCH=false

# 报表文件上传 OSS，并通过有时效的签名地址提供下载。
XPD_REPORT_OSS_ENABLED=true
XPD_REPORT_OSS_ENDPOINT=REPLACE_WITH_OSS_ENDPOINT
XPD_REPORT_OSS_REGION=REPLACE_WITH_OSS_REGION
XPD_REPORT_OSS_BUCKET=REPLACE_WITH_OSS_BUCKET
XPD_REPORT_OSS_PREFIX=REPLACE_WITH_OSS_PREFIX
XPD_REPORT_OSS_ACCESS_KEY_ID=REPLACE_WITH_REPORT_OSS_ACCESS_KEY_ID
XPD_REPORT_OSS_ACCESS_KEY_SECRET=REPLACE_WITH_REPORT_OSS_ACCESS_KEY_SECRET
XPD_REPORT_OSS_DOWNLOAD_EXPIRES_SECONDS=3600
